{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/build/vs2022-x64"
    },
    {
      "name": "ninja-x64-debug",
      "displayName": "Ninja x64 Debug (MSVC)",
      "inherits": "windows-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ninja-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-x64-release",
      "displayName": "Ninja x64 Release (MSVC)",
      "inherits": "windows-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ninja-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-x64-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x64-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "ninja-x64-debug",
      "configurePreset": "ninja-x64-debug"
    },
    {
      "name": "ninja-x64-release",
      "configurePreset": "ninja-x64-release"
    }
  ]
}

